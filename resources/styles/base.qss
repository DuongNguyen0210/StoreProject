* {
    font-family: "Urbanist", "Segoe UI", "Roboto", "Arial", sans-serif;
    font-size: 14px;
}

*:focus
{
    outline: none;
}

QMainWindow
{
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #E8F4FD,
        stop:1 #F0F9FF
    );
}

QWidget
{
    background-color: #FFFFFF;
    color: #1E293B;
}

QDialog
{
    background-color: #FFFFFF;
}
