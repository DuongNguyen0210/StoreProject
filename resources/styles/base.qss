/* ==================== BASE STYLES ==================== */

/* Universal font and size */
* {
    font-family: "Urbanist", "Segoe UI", "Roboto", "Arial", sans-serif;
    font-size: 14px;
}

/* Disable all focus outlines */
*:focus
{
    outline: none;
}

/* Main window background - Light blue gradient */
QMainWindow
{
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #E8F4FD,
        stop:1 #F0F9FF
    );
}

/* Default widget background */
QWidget
{
    background-color: #FFFFFF;
    color: #1E293B;
}

/* Dialog background */
QDialog
{
    background-color: #FFFFFF;
}
