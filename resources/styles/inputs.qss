QLineEdit
{
    background-color: #F0F9FF;
    color: #1E293B;
    border: 2px solid #BFDBFE;
    border-radius: 18px;
    padding: 10px 16px;
}

QLineEdit:focus
{
    border-color: #38BDF8;
    background-color: #FFFFFF;
}

QLineEdit:hover
{
    border-color: #7DD3FC;
}

QLineEdit::placeholder
{
    color: #94A3B8;
}

QLineEdit#SearchText,
QLineEdit#txtSearchCustomer
{
    background-color: #F0F9FF;
    border-radius: 22px;
    padding: 12px 22px;
    font-size: 15px;
}

QLineEdit#txtSearchCustomer,
QLineEdit#txtSearchPhoneCustomer
{
    background-color: #FFFFFF;
    border: 2px solid #BFDBFE;
    border-radius: 16px;
}

QDialog#LoginDialog QLineEdit:focus
{
    background-color: #FFFFFF;
    border: 2px solid #0EA5E9;
}

QComboBox
{
    background-color: #F0F9FF;
    color: #1E293B;
    border: 2px solid #BFDBFE;
    border-radius: 18px;
    padding: 8px 14px;
    min-height: 30px;
}

QComboBox:focus
{
    background-color: #FFFFFF;
    border-color: #38BDF8;
}

QComboBox:hover
{
    border-color: #7DD3FC;
}

QComboBox::drop-down
{
    background-color: transparent;
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView
{
    background-color: #FFFFFF;
    color: #1E293B;
    border: 1px solid #7DD3FC;
    border-radius: 16px;
    padding: 4px 0;
}

QComboBox QAbstractItemView::item
{
    padding: 6px 14px;
    border-radius: 10px;
}

QComboBox QAbstractItemView::item:selected
{
    background-color: rgba(14, 165, 233, 0.15);
    color: #0284C7;
}

QComboBox#Type
{
    background-color: #FFFFFF;
    border-color: #7DD3FC;
}

QSpinBox,
QDoubleSpinBox
{
    background-color: #F0F9FF;
    color: #1E293B;
    border: 2px solid #BFDBFE;
    border-radius: 16px;
    padding: 6px 12px;
    min-height: 30px;
}

QSpinBox:focus,
QDoubleSpinBox:focus
{
    background-color: #FFFFFF;
    border-color: #38BDF8;
}

QSpinBox:hover,
QDoubleSpinBox:hover
{
    border-color: #7DD3FC;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button
{
    background-color: transparent;
    border: none;
    width: 18px;
}

QAbstractSpinBox {
    selection-background-color: #0EA5E9;
    selection-color: #FFFFFF;
}

QDateEdit {
    background-color: #F0F9FF;
    color: #1E293B;
    border: 2px solid #BFDBFE;
    border-radius: 16px;
    padding: 6px 12px;
    min-height: 32px;
}

QDateEdit:focus {
    background-color: #FFFFFF;
    border-color: #38BDF8;
}

QDateEdit:hover {
    border-color: #7DD3FC;
}

QDateEdit::up-button,
QDateEdit::down-button {
    width: 0px;
    height: 0px;
    border: none;
    background: transparent;
}

QDateEdit::up-arrow,
QDateEdit::down-arrow {
    image: none;
}

QDateEdit::drop-down {
    width: 0px;
    border: none;
    background: transparent;
}

QCalendarWidget {
    background-color: #FFFFFF;
    border: 1px solid #7DD3FC;
    border-radius: 18px;
}

QCalendarWidget QToolButton {
    background-color: #F0F9FF;
    border-radius: 14px;
    padding: 4px 10px;
    color: #1E293B;
    font-weight: 500;
}

QCalendarWidget QToolButton:hover {
    background-color: #E0F2FE;
}

QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    selection-background-color: rgba(14, 165, 233, 0.2);
    selection-color: #0284C7;
}
