}

QLabel#lblLogo {
    background: white;
    border-radius: 10px;
    padding: 15px;
}

QLabel#lblUniversity, QLabel#lblFaculty, QLabel#lblDepartment {
    color: white;
    font-weight: bold;
    font-size: 16px;
}

QLabel#lblProjectTitle {
    color: #ffeb3b;
    font-weight: bold;
    font-size: 24px;
}

QLabel#lblSubtitle {
    color: #fff9c4;
    font-size: 14px;
    font-style: italic;
}

QFrame#loginFrame {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 15px;
    padding: 20px;
}

QLabel#lblLoginTitle {
    color: #1a237e;
    font-size: 22px;
    font-weight: bold;
}

QLabel#labeUsername, QLabel#labePassword {
    color: #424242;
    font-size: 13px;
    font-weight: 500;
}

QLineEdit {
    padding: 12px 15px;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    font-size: 14px;
    background: white;
}

QLineEdit:focus {
    border: 2px solid #3949ab;
    background: #f5f5f5;
}

QPushButton#btnLogin {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #3949ab, stop:1 #5c6bc0);
    color: white;
    font-size: 16px;
    font-weight: bold;
    border: none;
    border-radius: 8px;
    padding: 15px;
}

QPushButton#btnLogin:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #303f9f, stop:1 #3949ab);
}

QPushButton#btnLogin:pressed {
    background: #283593;
}

QCheckBox {
    color: #424242;
    font-size: 12px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 3px;
    border: 2px solid #bdbdbd;
}

QCheckBox::indicator:checked {
    background: #3949ab;
    border: 2px solid #3949ab;
}

QLabel#lblError {
    color: #d32f2f;
    font-size: 13px;
    font-weight: 500;
}

QLabel#lblProjectInfo {
    color: white;
    font-size: 11px;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 5px;
    padding: 10px;
}
</string>
